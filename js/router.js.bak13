                        <div class="stat-icon">
                            <i class="bi bi-tags"></i>
                        </div>
                        <div class="stat-value">${stats.data.totalVersions}</div>
                        <div class="stat-label" data-i18n="dashboard.totalVersions">版本总数</div>
                        <div class="stat-trend up">
                            <i class="bi bi-arrow-up"></i> 8.5%
                        </div>
