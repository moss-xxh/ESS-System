                            <select class="form-select" name="edition" required>
                                <option value="basic" ${customer.edition === 'basic' ? 'selected' : ''}>基础版</option>
                                <option value="professional" ${customer.edition === 'professional' ? 'selected' : ''}>专业版</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">状态 <span class="text-danger">*</span></label>
                            <select class="form-select" name="status" required>
                                <option value="active" ${customer.status === 'active' ? 'selected' : ''}>正常</option>
                                <option value="inactive" ${customer.status === 'inactive' ? 'selected' : ''}>停用</option>
